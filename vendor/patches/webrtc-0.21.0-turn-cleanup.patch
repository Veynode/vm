+    /// Veynode: after event_loop's receive futures are dropped, keep the same
+    /// UDP sockets alive for at most750ms to send and authenticate Refresh(0).
+    pub(crate) async fn shutdown_turn(&mut self) -> bool {
+        let runtime = self.inner.runtime.clone();
+        let expires = runtime.now() + Duration::from_millis(750);
+        let deadline = runtime.sleep(Duration::from_millis(750)).fuse();
+        let cleanup=async {
+            loop {
+                if runtime.now()>=expires {return Err(Error::Other("TURN cleanup deadline".into()))}
+                if self.turn_relayer.prepare_deallocation()? { return Ok::<(),Error>(()) }
+                while let Some(packet)=self.turn_relayer.poll_write() {
+                    let socket=self.udp_sockets.get(&packet.transport.local_addr).ok_or_else(||Error::Other("TURN cleanup socket missing".into()))?;
+                    let sent=socket.send_to(&packet.message,packet.transport.peer_addr).await?;
+                    if sent!=packet.message.len(){return Err(Error::Other("partial TURN cleanup send".into()))}
+                }
+                let mut reads=FuturesUnordered::new();
+                for (local,socket) in &self.udp_sockets {
+                    let (local,socket)=(*local,socket.clone());
+                    reads.push(async move {let mut bytes=vec![0u8;4096];let result=socket.recv_from(&mut bytes).await; (local,bytes,result)});
+                }
+                let tick=runtime.sleep(Duration::from_millis(20)).fuse();
+                futures::pin_mut!(tick);
+                futures::select! {
+                    packet=reads.next().fuse()=>{
+                        let Some((local,bytes,result))=packet else {return Err(Error::Other("TURN cleanup sockets unavailable".into()))};
+                        if let Ok((len,peer))=result {
+                            self.turn_relayer.handle_deallocation_read(TaggedBytesMut{now:runtime.now(),transport:TransportContext{local_addr:local,peer_addr:peer,ecn:None,transport_protocol:TransportProtocol::UDP},message:BytesMut::from(&bytes[..len])})?;
+                        }
+                    },
+                    _=tick=>{self.turn_relayer.handle_timeout(runtime.now())?;}
+                }
+            }
+        }.fuse();
+        futures::pin_mut!(deadline, cleanup);
+        let released = futures::select! {result=cleanup=>result.is_ok(),_=deadline=>false};
+        self.inner
+            .turn_cleanup
+            .store(if released { 1 } else { 2 }, Ordering::Release);
+        released
+    }
