+    #[test]
+    fn deallocation_ack_requires_hmac_transaction_type_source_and_zero_lifetime() {
+        futures::executor::block_on(async {
+            use rtc::stun::integrity::MessageIntegrity;
+            use rtc::stun::message::{METHOD_ALLOCATE, METHOD_REFRESH};
+            use rtc::turn::proto::lifetime::Lifetime;
+            let local: SocketAddr = "127.0.0.1:54000".parse().unwrap();
+            let server: SocketAddr = "127.0.0.1:3478".parse().unwrap();
+            let provider = rtc::crypto::default_provider().unwrap();
+            let mut relayer = RTCTurnRelayer::new(
+                vec![local],
+                vec![RTCIceServer {
+                    urls: vec![format!("turn:{server}?transport=udp")],
+                    username: "fixture".into(),
+                    credential: "private-test-value".into(),
+                }],
+                RTCIceTransportPolicy::Relay,
+                None,
+                crate::runtime::default_runtime().unwrap(),
+                provider.clone(),
+            );
+            relayer.gather().await.unwrap();
+            let key = FourTuple {
+                local_addr: local,
+                peer_addr: server,
+            };
+            let tid = TransactionId::new();
+            let integrity = vec![0x11; 16];
+            relayer.clients.get_mut(&key).unwrap().release = Some(ReleaseProof {
+                transaction: tid,
+                integrity: integrity.clone(),
+                confirmed: false,
+            });
+            for variant in 0..8 {
+                let mut response = StunMessage::new();
+                response
+                    .build(&[
+                        Box::new(if variant == 0 {
+                            TransactionId::new()
+                        } else {
+                            tid
+                        }),
+                        Box::new(MessageType::new(
+                            if variant == 1 {
+                                METHOD_ALLOCATE
+                            } else {
+                                METHOD_REFRESH
+                            },
+                            CLASS_SUCCESS_RESPONSE,
+                        )),
+                        Box::new(Lifetime(if variant == 2 {
+                            Duration::from_secs(1)
+                        } else {
+                            Duration::ZERO
+                        })),
+                        Box::new(MessageIntegrity::new_raw_integrity_with_provider(
+                            if variant == 3 {
+                                vec![0x22; 16]
+                            } else {
+                                integrity.clone()
+                            },
+                            provider.crypto(),
+                        )),
+                    ])
+                    .unwrap();
+                if variant == 5 {
+                    // Strip the integrity attribute; an unsigned success is not proof.
+                    response.raw.truncate(response.raw.len() - 24);
+                    let length = (response.raw.len() - 20) as u16;
+                    response.raw[2..4].copy_from_slice(&length.to_be_bytes());
+                }
+                if variant == 6 {
+                    // Appended duplicate LIFETIME is outside the HMAC span.
+                    response.raw.extend_from_slice(&[0, 13, 0, 4, 0, 0, 0, 0]);
+                    let length = (response.raw.len() - 20) as u16;
+                    response.raw[2..4].copy_from_slice(&length.to_be_bytes());
+                }
+                let from = if variant == 4 {
+                    "127.0.0.1:3479".parse().unwrap()
+                } else {
+                    server
+                };
+                relayer
+                    .handle_deallocation_read(tagged(local, from, &response.raw))
+                    .unwrap();
+                assert_eq!(
+                    relayer.clients[&key].release.as_ref().unwrap().confirmed,
+                    variant == 7,
+                    "variant{variant}"
+                );
+            }
