+    /// A random transaction ID alone is not a resource-release proof. Require
+    /// the exact server socket, REFRESH success, zero lifetime and its HMAC.
+    pub(crate) fn handle_deallocation_read(&mut self, message: TaggedBytesMut) -> Result<()> {
+        let key = FourTuple::from(&message.transport);
+        let Some(client) = self.clients.get_mut(&key) else {
+            return Ok(());
+        };
+        if let Some(proof) = client.release.as_mut() {
+            let mut reply = StunMessage::new();
+            reply.raw = message.message.to_vec();
+            if reply.decode().is_err()
+                || reply.transaction_id != proof.transaction
+                || reply.typ.method != rtc::stun::message::METHOD_REFRESH
+                || reply.typ.class != CLASS_SUCCESS_RESPONSE
+            {
+                return Ok(());
+            }
+            // MESSAGE-INTEGRITY authenticates only preceding attributes. Never
+            // accept an appended/repeated lifetime outside the authenticated span.
+            let mut offset = 20;
+            let mut lifetime_count = 0;
+            let mut integrity_count = 0;
+            let mut attributes_valid = true;
+            while offset + 4 <= reply.raw.len() {
+                let typ = u16::from_be_bytes([reply.raw[offset], reply.raw[offset + 1]]);
+                let len =
+                    u16::from_be_bytes([reply.raw[offset + 2], reply.raw[offset + 3]]) as usize;
+                if offset + 4 + len > reply.raw.len() {
+                    attributes_valid = false;
+                    break;
+                }
+                if typ == 0x000d {
+                    lifetime_count += 1;
+                    if integrity_count != 0 {
+                        attributes_valid = false;
+                    }
+                }
+                if typ == 0x0008 {
+                    integrity_count += 1;
+                }
+                offset += 4 + ((len + 3) & !3);
+            }
+            if !attributes_valid
+                || offset != reply.raw.len()
+                || lifetime_count != 1
+                || integrity_count != 1
+            {
+                return Ok(());
+            }
+            if reply
+                .get(rtc::stun::attributes::ATTR_LIFETIME)
+                .ok()
+                .as_deref()
+                != Some(&[0, 0, 0, 0])
+            {
+                return Ok(());
+            }
+            if rtc::stun::integrity::MessageIntegrity::check(
+                &mut reply,
+                &proof.integrity,
+                self.crypto_provider.crypto(),
+            )
+            .is_err()
+            {
+                return Ok(());
+            }
+            proof.confirmed = true;
+            client.client.close()?;
+            Ok(())
+        } else {
+            // Allocation might have completed on the server while close raced its
+            // reply. Preserve it, learn its address, then delete it on the next pass.
+            self.handle_read(message)?;
+            while self.poll_event().is_some() {}
+            Ok(())
+        }
+    }
