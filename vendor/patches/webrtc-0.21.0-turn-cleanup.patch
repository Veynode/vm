+    /// Veynode: queue authenticated Refresh(0), retaining transactions until a
+    /// matching authenticated server acknowledgement. Called only after normal
+    /// media/event processing has stopped; late Allocate replies are still drained.
+    pub(crate) fn prepare_deallocation(&mut self) -> Result<bool> {
+        for managed in self.clients.values_mut() {
+            if let Some(addr) = managed.relay_addr {
+                if managed.release.is_none() {
+                    managed.client.close()?;
+                    while managed.client.poll_write().is_some() {}
+                    managed.client.relay(addr)?.close(self.runtime.now())?;
+                    let packet = managed
+                        .client
+                        .poll_write()
+                        .ok_or_else(|| Error::Other("TURN deallocation request missing".into()))?;
+                    let mut request = StunMessage::new();
+                    request.raw = packet.message.to_vec();
+                    request.decode()?;
+                    let username =
+                        String::from_utf8(request.get(rtc::stun::attributes::ATTR_USERNAME)?)
+                            .map_err(|_| Error::Other("TURN username encoding".into()))?;
+                    let realm = String::from_utf8(request.get(rtc::stun::attributes::ATTR_REALM)?)
+                        .map_err(|_| Error::Other("TURN realm encoding".into()))?;
+                    let integrity =
+                        rtc::stun::integrity::MessageIntegrity::long_term_integrity_key(
+                            username,
+                            realm,
+                            managed.password.clone(),
+                            self.crypto_provider.crypto(),
+                        )?;
+                    managed.release = Some(ReleaseProof {
+                        transaction: request.transaction_id,
+                        integrity,
+                        confirmed: false,
+                    });
+                    self.wouts.push_back(packet);
+                }
+            }
+        }
+        Ok(!self.cleanup_unknown
+            && self.clients.values().all(|client| {
+                client.gather_finished
+                    && match &client.release {
+                        Some(proof) => proof.confirmed,
+                        None => client.relay_addr.is_none(),
+                    }
+            }))
+    }
