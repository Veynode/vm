#!/bin/sh
# Container entrypoint shared by the desktop images: device discovery, Xorg on
# the virtio-gpu scanout, then an XFCE session. Reports the GL and Vulkan
# renderers on stdout (container logs).
set -u
# The session runs as VEYNODEVM_DESKTOP_USER when the image has that user
# (ubuntu-desktop: veynode); Xorg stays root. Without one it runs as root.
user=${VEYNODEVM_DESKTOP_USER:-}
if [ -n "$user" ] && uid=$(id -u "$user" 2>/dev/null); then
    home=$(getent passwd "$user" | cut -d: -f6)
else
    user= uid=0 home=/root
fi
export XDG_RUNTIME_DIR=/run/user/$uid
mkdir -p /run/udev /tmp/.X11-unix "$XDG_RUNTIME_DIR"
# The container is starting, so no X server runs; a lock left by an unclean
# stop (it lives in the writable layer) would make Xorg refuse to start.
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0
chmod 1777 /tmp/.X11-unix
chmod 0700 "$XDG_RUNTIME_DIR"
[ -n "$user" ] && chown "$user:" "$XDG_RUNTIME_DIR"
# The container root is a chroot of the agent's PID 1 root; systemd's udevadm
# ignores trigger and settle there, leaving input devices unknown to Xorg.
export SYSTEMD_IGNORE_CHROOT=1
# eudev (Alpine) installs udevd on PATH; systemd distributions keep it private.
for udevd in udevd /lib/systemd/systemd-udevd /usr/lib/systemd/systemd-udevd; do
    command -v "$udevd" >/dev/null 2>&1 && break
done
"$udevd" --daemon
udevadm trigger --action=add
udevadm settle --timeout=10
if [ ! -e /dev/dri/card0 ]; then
    echo "veynodevm-desktop: no /dev/dri/card0 (run with --desktop)" >&2
    exit 1
fi
mkdir -p /var/lib/dbus
dbus-uuidgen --ensure
Xorg :0 vt1 -nolisten tcp -noreset -logfile /tmp/Xorg.0.log &
xorg=$!
for _ in $(seq 100); do
    [ -S /tmp/.X11-unix/X0 ] && break
    kill -0 "$xorg" 2>/dev/null || { echo "Xorg exited; see /tmp/Xorg.0.log" >&2; tail -20 /tmp/Xorg.0.log >&2; exit 1; }
    sleep 0.1
done
export DISPLAY=:0
vulkan=$(vulkaninfo --summary 2>/dev/null | grep -E "deviceName|driverName")
echo "$vulkan" | sed '/^$/d; s/^ */desktop: vulkan /'
# On Venus, OpenGL runs on Vulkan through Zink (GL 3.1, GLES 3.1) instead of
# virgl (GL 2.1, GLES 3.0); the image's Vulkan layer works around MoltenVK.
# Set MESA_LOADER_DRIVER_OVERRIDE=virtio_gpu to get virgl back.
if [ -z "${MESA_LOADER_DRIVER_OVERRIDE:-}" ] && echo "$vulkan" | grep -q "driverName *= *venus" \
    && [ -e /usr/share/vulkan/implicit_layer.d/veynodevm_zink_layer.json ]; then
    export MESA_LOADER_DRIVER_OVERRIDE=zink
fi
glxinfo -B 2>/dev/null | grep -E "OpenGL (renderer|version) string" | sed 's/^/desktop: /'
echo "desktop: XFCE session starting on :0${user:+ as $user}"
if [ -n "$user" ]; then
    exec runuser -u "$user" -- env HOME="$home" USER="$user" LOGNAME="$user" dbus-run-session startxfce4
fi
exec dbus-run-session startxfce4
